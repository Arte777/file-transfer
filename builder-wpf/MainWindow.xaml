<Window x:Class="NexusBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS — Universal Builder v8.0.0" 
        Height="800" Width="960" 
        MinHeight="720" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#e2e8f0"
        FontFamily="Segoe UI, Inter, Roboto, Arial">
    
    <Window.Resources>
        <!-- Glass Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14182b" Offset="0" />
                        <GradientStop Color="#0d101e" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#222948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#13172b" />
            <Setter Property="Foreground" Value="#f1f5f9" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242c52" />
                                <Setter Property="Foreground" Value="#00f0ff" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1b2447" />
                                <Setter Property="Foreground" Value="#00f0ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for ComboBox -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="bg" Background="#111528" BorderBrush="#2c355c" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent" />
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#00f0ff" Data="M 0 0 L 5 5 L 10 0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="#00f0ff" />
                    <Setter TargetName="bg" Property="Background" Value="#181f3b" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="Background" Value="#111528" />
            <Setter Property="BorderBrush" Value="#2c355c" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource DarkComboToggle}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="14,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#ffffff" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0f1325" BorderThickness="1" BorderBrush="#00f0ff" CornerRadius="10" Margin="0,4,0,0" Padding="4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#222b4c" />
                                <Setter Property="Foreground" Value="#00f0ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#ef4444" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Cyber Action Button Style -->
        <Style x:Key="ActionCardButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <!-- Purple Gradient Button (Standalone) -->
        <Style x:Key="BtnStandaloneStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButton}">
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#8b5cf6" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7c3aed" Offset="0" />
                        <GradientStop Color="#4c1d95" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9333ea" Offset="0" />
                                            <GradientStop Color="#6b21a8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="BorderBrush" Value="#d8b4fe" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyan Gradient Button (Client) -->
        <Style x:Key="BtnClientStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButton}">
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#06b6d4" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284c7" Offset="0" />
                        <GradientStop Color="#09426f" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0ea5e9" Offset="0" />
                                            <GradientStop Color="#0369a1" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="BorderBrush" Value="#67e8f9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emerald Gradient Button (Setup Installer) -->
        <Style x:Key="BtnInstallerStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButton}">
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#10b981" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#059669" Offset="0" />
                        <GradientStop Color="#064e3b" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10b981" Offset="0" />
                                            <GradientStop Color="#047857" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="b" Property="BorderBrush" Value="#6ee7b7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#171b30" />
            <Setter Property="Foreground" Value="#cbd5e1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2b345a" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262f55" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00f0ff" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark CheckBox Style -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e2e8f0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBorder" Width="18" Height="18" CornerRadius="5" Background="#111528" BorderBrush="#2c355c" BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="checkMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#00f0ff" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="checkBorder" Property="Background" Value="#172242" />
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#00f0ff" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#00f0ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- OUTER GLOW CONTAINER -->
    <Border Margin="14" CornerRadius="16" BorderThickness="1" BorderBrush="#222a4d">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090b14" Offset="0" />
                <GradientStop Color="#0d101e" Offset="0.5" />
                <GradientStop Color="#07080f" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#00f0ff" Opacity="0.14" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Window Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Banner & Quick Status -->
                <RowDefinition Height="Auto" /> <!-- Options & Target Grid -->
                <RowDefinition Height="Auto" /> <!-- 3 Build Action Cards -->
                <RowDefinition Height="*" />    <!-- Terminal Console -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM TITLE BAR -->
            <Border Grid.Row="0" Background="#0b0e1b" CornerRadius="16,16,0,0" BorderBrush="#1c223c" BorderThickness="0,0,0,1" Padding="18,10" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ NEXUS" Foreground="#00f0ff" FontSize="16" FontWeight="Black" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="BUILDER" Foreground="#ffffff" FontSize="16" FontWeight="Black" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border Background="#1e1b4b" BorderBrush="#818cf8" BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="v8.0.0 ULTRA" Foreground="#a5b4fc" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <Border Background="#064e3b" BorderBrush="#10b981" BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#34d399" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="ONLINE • READY" Foreground="#6ee7b7" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Drag spacer -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click" ToolTip="Свернуть" />
                        <Button Content="✕" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Закрыть" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. QUICK BANNER -->
            <Border Grid.Row="1" Margin="20,14,20,12" Background="#101426" BorderBrush="#202747" BorderThickness="1" CornerRadius="12" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Генератор исполняемых клиентов и полноценных инсталляторов (Setup.exe)" Foreground="#e2e8f0" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Данные жертвы автоматически отправляются в веб-панель выбранного оператора в режиме реального времени." Foreground="#94a3b8" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#161c36" BorderBrush="#2f3a68" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="🛠️ .NET 8 x64 Native" Foreground="#38bdf8" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="badgeInnoStatus" Background="#162a22" BorderBrush="#10b981" BorderThickness="1" CornerRadius="8" Padding="10,4">
                            <TextBlock x:Name="lblInnoStatus" Text="💿 Inno Setup 6: Готов" Foreground="#34d399" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. CONFIGURATION & OPTIONS (2 Cards) -->
            <Grid Grid.Row="2" Margin="20,0,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Target Operator & Output -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🎯 МАРШРУТИЗАЦИЯ И ПРОФИЛЬ ОПЕРАТОРА" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="Выберите профиль оператора для привязки собираемого приложения:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,10" />

                        <ComboBox x:Name="cbOperators" Height="38" Style="{StaticResource DarkComboBox}" SelectionChanged="CbOperators_SelectionChanged">
                            <ComboBoxItem Content="💀 HuilaEbanaya (Воркер)" IsSelected="True" Tag="HuilaEbanaya" />
                            <ComboBoxItem Content="🦊 Shonll (Главный Администратор)" Tag="Shonll" />
                            <ComboBoxItem Content="🐉 DildMan (Воркер)" Tag="DildMan" />
                            <ComboBoxItem Content="🔗 saha_kakaha122 (SVYAZ)" Tag="saha_kakaha122" />
                            <ComboBoxItem Content="🎤 SinGeR1isss (Воркер)" Tag="SinGeR1isss" />
                            <ComboBoxItem Content="✏️ [ Ввести вручную... ]" Tag="__custom__" />
                        </ComboBox>

                        <TextBox x:Name="tbCustomOperator" Height="34" Margin="0,6,0,0" Background="#151a30" Foreground="#00f0ff" BorderBrush="#00f0ff" BorderThickness="1" FontSize="12" Padding="10,6" Visibility="Collapsed" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Имя приложения:" Foreground="#64748b" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="tbAppName" Text="RAH" Height="34" Background="#111528" Foreground="#ffffff" BorderBrush="#2c355c" FontSize="12" Padding="8,6" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Папка назначения:" Foreground="#64748b" FontSize="11" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="tbOutputPath" Grid.Column="0" Height="34" Background="#111528" Foreground="#ffffff" BorderBrush="#2c355c" FontSize="11" Padding="8,6" IsReadOnly="True" />
                                    <Button x:Name="btnBrowse" Grid.Column="1" Content="📁 Обзор" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Height="34" Padding="10,0" Click="BtnBrowse_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: Setup & Packaging Options -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="⚙️ ПАРАМЕТРЫ ИНСТАЛЛЯТОРА (SETUP WIZARD)" Foreground="#a855f7" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="Настройки сборки полноценного пакета установки:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,10" />

                        <TextBlock Text="Тип приложения в инсталляторе:" Foreground="#64748b" FontSize="11" Margin="0,0,0,4" />
                        <ComboBox x:Name="cbInstallerTarget" Height="36" Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Content="⚡ Standalone PRO (Автономный)" IsSelected="True" Tag="standalone" />
                            <ComboBoxItem Content="🚀 Client Loader (Скрытый)" Tag="client" />
                        </ComboBox>

                        <StackPanel Margin="0,12,0,0">
                            <CheckBox x:Name="chkDesktopShortcut" Content="Создать ярлык на Рабочем столе" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,8" />
                            <CheckBox x:Name="chkCompressLzma" Content="Ультра-сжатие LZMA2 (уменьшает вес до ~45 МБ)" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,8" />
                            <CheckBox x:Name="chkRunAsAdmin" Content="Запуск от имени администратора (UAC)" Style="{StaticResource DarkCheckBox}" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. THREE BUILD ACTION BUTTONS -->
            <Grid Grid.Row="3" Margin="20,0,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- Button 1: Standalone -->
                <Button x:Name="btnBuildStandalone" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource BtnStandaloneStyle}" Click="BtnBuildStandalone_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Standalone EXE" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="PRO автономный .exe" Foreground="#f5f3ff" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Пишет accounts.txt на Рабочий стол" Foreground="#c4b5fd" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Button 2: Client -->
                <Button x:Name="btnBuildClient" Grid.Column="1" Margin="4,0,4,0" Style="{StaticResource BtnClientStyle}" Click="BtnBuildClient_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Client Loader EXE" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Фоновый клиент Runtime Broker" Foreground="#e0f2fe" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Скрытая синхронизация с сервером" Foreground="#7dd3fc" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Button 3: Setup Installer (NEW) -->
                <Button x:Name="btnBuildInstaller" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource BtnInstallerStyle}" Click="BtnBuildInstaller_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="💿" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Собрать Инсталлятор (Setup.exe)" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Мастер установки Inno Setup" Foreground="#ecfdf5" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Ярлык + Деинсталлятор + Сжатие" Foreground="#6ee7b7" FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 5. TERMINAL & CONSOLE STREAM -->
            <Border Grid.Row="4" Margin="20,0,20,18" Style="{StaticResource GlassCard}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Top Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- MacOS style window dots -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="10" Height="10" Fill="#ef4444" Margin="0,0,6,0" />
                            <Ellipse Width="10" Height="10" Fill="#f59e0b" Margin="0,0,6,0" />
                            <Ellipse Width="10" Height="10" Fill="#10b981" />
                        </StackPanel>

                        <!-- Terminal Title & Status -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text=">_ NEXUS CORE STREAM" Foreground="#00f0ff" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Bold" Margin="0,0,10,0" />
                            <TextBlock x:Name="lblStatus" Text="• Ожидание команды пользователя..." Foreground="#64748b" FontSize="11" />
                        </StackPanel>

                        <!-- Quick Action in Terminal -->
                        <Button x:Name="btnOpenFolder" Grid.Column="2" Content="📂 Открыть папку со сборкой" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="11" Click="BtnOpenFolder_Click" Visibility="Collapsed" />
                    </Grid>

                    <!-- Console Box -->
                    <Border Grid.Row="1" Background="#06070d" BorderBrush="#181d32" BorderThickness="1" CornerRadius="8" Padding="2">
                        <ScrollViewer x:Name="scrollConsole" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtConsole" Background="Transparent" Foreground="#38bdf8" FontFamily="Cascadia Code, Consolas, JetBrains Mono, monospace" FontSize="11.5" IsReadOnly="True" BorderThickness="0" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" />
                        </ScrollViewer>
                    </Border>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="pbProgress" Grid.Row="2" Height="4" Margin="0,8,0,0" Background="#111526" Foreground="#00f0ff" BorderThickness="0" Value="0" />
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
