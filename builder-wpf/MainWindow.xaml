<Window x:Class="NexusBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Builder v8.0.0" 
        Height="720" Width="920" 
        MinHeight="660" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#e2e8f0"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">
    
    <Window.Resources>
        <!-- Modern Clean Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#161922" />
            <Setter Property="BorderBrush" Value="#232733" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Clean Dark Input Style -->
        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0f1117" />
            <Setter Property="Foreground" Value="#f1f5f9" />
            <Setter Property="BorderBrush" Value="#2d3342" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3b82f6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0f1117" />
            <Setter Property="Foreground" Value="#f1f5f9" />
            <Setter Property="BorderBrush" Value="#2d3342" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3b82f6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161922" />
            <Setter Property="Foreground" Value="#f1f5f9" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252b3b" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for ComboBox -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="bg" Background="#0f1117" BorderBrush="#2d3342" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent" />
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#94a3b8" Data="M 0 0 L 4 4 L 8 0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="#3b82f6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#f1f5f9" />
            <Setter Property="Background" Value="#0f1117" />
            <Setter Property="BorderBrush" Value="#2d3342" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource DarkComboToggle}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#f1f5f9" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#161922" BorderThickness="1" BorderBrush="#2d3342" CornerRadius="8" Margin="0,4,0,0" Padding="3">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#232733" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#dc2626" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#202430" />
            <Setter Property="Foreground" Value="#cbd5e1" />
            <Setter Property="BorderBrush" Value="#2d3342" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2a3040" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#3d4659" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean CheckBox Style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Primary Action Button (Standalone) -->
        <Style x:Key="BtnPrimaryStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="Background" Value="#2563eb" />
            <Setter Property="BorderBrush" Value="#3b82f6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1d4ed8" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#60a5fa" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button (Client) -->
        <Style x:Key="BtnSecondaryActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="Background" Value="#1e2433" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#293042" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- WINDOW CONTAINER -->
    <Border Background="#0f1117" BorderBrush="#232733" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />   <!-- Clean Title Bar -->
                <RowDefinition Height="*" />    <!-- Content Area (Login OR Main) -->
            </Grid.RowDefinitions>

            <!-- 1. CLEAN TITLE BAR -->
            <Border Grid.Row="0" Background="#161922" CornerRadius="10,10,0,0" BorderBrush="#232733" BorderThickness="0,0,0,1" Padding="16,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#3b82f6" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="NEXUS BUILDER" Foreground="#f1f5f9" FontSize="13" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border Background="#1e293b" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v8.0.0 Cloud Sync" Foreground="#38bdf8" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- User Session Pill & Drag Spacer -->
                    <Grid Grid.Column="1" Background="Transparent">
                        <StackPanel x:Name="badgeUserSession" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" Visibility="Collapsed">
                            <Border Background="#1e2433" BorderBrush="#2d3342" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤 " FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="lblLoggedInUser" Text="Operator" Foreground="#f1f5f9" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Border x:Name="borderRoleBadge" Background="#2563eb" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                        <TextBlock x:Name="lblLoggedInRole" Text="ADMIN" Foreground="#ffffff" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Button x:Name="btnLogout" Content="Выйти" Style="{StaticResource SecondaryButton}" Height="22" Padding="7,0" FontSize="10.5" Click="BtnLogout_Click" ToolTip="Сменить профиль" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click" ToolTip="Свернуть" />
                        <Button Content="✕" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Закрыть" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. LOGIN SCREEN (Visible until authenticated) -->
            <Grid x:Name="gridAuthLogin" Grid.Row="1" Visibility="Visible">
                <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ModernCard}" Padding="28,26">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border Width="46" Height="46" CornerRadius="10" Background="#1e2433" BorderBrush="#2d3342" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Вход в Nexus Builder" Foreground="#f1f5f9" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Авторизуйтесь для доступа к сборщику" Foreground="#94a3b8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Error Message -->
                        <Border x:Name="borderAuthError" Background="#261417" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="txtAuthError" Text="Неверный логин или пароль" Foreground="#f87171" FontSize="11.5" TextWrapping="Wrap" />
                        </Border>

                        <!-- Username -->
                        <TextBlock Text="Логин (имя профиля)" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="tbAuthLogin" Style="{StaticResource ModernInput}" Margin="0,0,0,12" KeyDown="TbAuthField_KeyDown" />

                        <!-- Password -->
                        <TextBlock Text="Пароль" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="pbAuthPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,14" KeyDown="TbAuthField_KeyDown" />

                        <!-- Remember session -->
                        <CheckBox x:Name="chkRememberSession" Content="Запомнить вход на этом ПК" Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="0,0,0,18" />

                        <!-- Submit Button -->
                        <Button x:Name="btnAuthLogin" Content="Войти в систему" Style="{StaticResource BtnPrimaryStyle}" Height="40" FontSize="13" FontWeight="Bold" Click="BtnAuthLogin_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. MAIN BUILDER WORKSPACE (Clean, Minimalist, 2 Buttons) -->
            <Grid x:Name="gridMainBuilder" Grid.Row="1" Visibility="Collapsed" Margin="18,16,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Config Panel -->
                    <RowDefinition Height="Auto" /> <!-- The 2 Action Buttons -->
                    <RowDefinition Height="*" />    <!-- Console Stream -->
                </Grid.RowDefinitions>

                <!-- CONFIG PANEL (Top Card) -->
                <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Operator Profile, App Name, Author / Publisher, Telegram Channel -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.75*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="1.05*" />
                            </Grid.ColumnDefinitions>

                            <!-- Operator Profile -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Профиль оператора:" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                                
                                <Border x:Name="borderNonAdminNotice" Background="#1a202c" BorderBrush="#2d3748" BorderThickness="1" CornerRadius="6" Padding="10,7" Visibility="Collapsed">
                                    <TextBlock x:Name="txtNonAdminNotice" Text="🔒 Заблокирован: Ваш аккаунт" Foreground="#60a5fa" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <ComboBox x:Name="cbOperators" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="CbOperators_SelectionChanged">
                                    <ComboBoxItem Content="💀 HuilaEbanaya" IsSelected="True" Tag="HuilaEbanaya" />
                                    <ComboBoxItem Content="🦊 Shonll" Tag="Shonll" />
                                    <ComboBoxItem Content="🐉 DildMan" Tag="DildMan" />
                                    <ComboBoxItem Content="🔗 saha_kakaha122" Tag="saha_kakaha122" />
                                    <ComboBoxItem Content="🎤 SinGeR1isss" Tag="SinGeR1isss" />
                                    <ComboBoxItem Content="✏️ [ Ввести вручную... ]" Tag="__custom__" />
                                </ComboBox>
                                
                                <TextBox x:Name="tbCustomOperator" Style="{StaticResource ModernInput}" Height="30" Margin="0,6,0,0" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- App Name -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Имя приложения:" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox x:Name="tbAppName" Text="RAH" Height="34" Style="{StaticResource ModernInput}" />
                            </StackPanel>

                            <!-- Author / Publisher -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Автор / Издатель:" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox x:Name="tbAuthor" Text="RAH Team" Height="34" Style="{StaticResource ModernInput}" ToolTip="Отображается в автозагрузке диспетчера задач и свойствах EXE" />
                            </StackPanel>

                            <!-- Telegram Channel -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Telegram-канал:" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox x:Name="tbTelegramChannel" Text="@robloxvzlomez" Height="34" Style="{StaticResource ModernInput}" ToolTip="Ссылка на ТГ-канал или юзернейм (@канал)" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Icon Selection & Destination Folder -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon Selection -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Иконка приложения (.ico):" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Mini Icon Preview Box -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#0f1117" BorderBrush="#2d3342" BorderThickness="1" Margin="0,0,8,0">
                                        <Image x:Name="imgIconPreview" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <!-- Icon Preset Selector -->
                                    <ComboBox x:Name="cbIconPresets" Grid.Column="1" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="CbIconPresets_SelectionChanged">
                                        <ComboBoxItem Content="⚡ Thunder (Молния)" IsSelected="True" Tag="thunder" />
                                        <ComboBoxItem Content="🔥 Fire (Огонь)" Tag="fire" />
                                        <ComboBoxItem Content="🔗 Svyaz (Цепь)" Tag="svyaz" />
                                        <ComboBoxItem Content="🎤 Singer (Микрофон)" Tag="singer" />
                                        <ComboBoxItem Content="💀 Cyber (Череп)" Tag="cyber" />
                                        <ComboBoxItem Content="📁 [ Выбрать свой .ico... ]" Tag="__custom_ico__" />
                                    </ComboBox>
                                    
                                    <Button x:Name="btnBrowseIcon" Grid.Column="2" Content="Обзор" Style="{StaticResource SecondaryButton}" Height="34" Margin="6,0,0,0" Padding="10,0" Click="BtnBrowseIcon_Click" ToolTip="Выбрать свой .ico файл с диска" />
                                </Grid>
                                <TextBlock x:Name="lblIconName" Text="thunder.ico" Foreground="#64748b" FontSize="10.5" Margin="42,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Destination Folder -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Папка сохранения:" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="tbOutputPath" Grid.Column="0" Height="34" Style="{StaticResource ModernInput}" IsReadOnly="True" />
                                    <Button x:Name="btnBrowse" Grid.Column="1" Content="Выбрать папку" Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Padding="12,0" Click="BtnBrowse_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- THE TWO ACTION BUTTONS (Clean, Prominent, Exactly what was requested) -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- BUTTON 1: STANDALONE INSTALLER -->
                    <Button x:Name="btnBuildStandaloneInstaller" Grid.Column="0" Margin="0,0,7,0" Style="{StaticResource BtnPrimaryStyle}" Click="BtnBuildStandaloneInstaller_Click">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1d4ed8" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Собрать Standalone Инсталлятор" Foreground="#ffffff" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="Автономный Setup • Program Files • accounts.txt на Рабочий стол" Foreground="#bfdbfe" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- BUTTON 2: CLIENT INSTALLER -->
                    <Button x:Name="btnBuildClientInstaller" Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource BtnSecondaryActionStyle}" Click="BtnBuildClientInstaller_Click">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#263042" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Собрать Client Инсталлятор" Foreground="#ffffff" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="Клиентский Setup • Program Files • Отправка логов на сервер" Foreground="#94a3b8" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- CONSOLE & PROGRESS (Clean, Minimalist Terminal) -->
                <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Terminal Header Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Лог процесса:" Foreground="#64748b" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock x:Name="lblStatus" Text="Готов к сборке" Foreground="#94a3b8" FontSize="11.5" />
                            </StackPanel>

                            <Button x:Name="btnOpenFolder" Grid.Column="1" Content="📂 Открыть папку со сборкой" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" FontSize="11" Click="BtnOpenFolder_Click" Visibility="Collapsed" />
                        </Grid>

                        <!-- Console Box -->
                        <Border Grid.Row="1" Background="#0b0d12" BorderBrush="#1c202a" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ScrollViewer x:Name="scrollConsole" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="txtConsole" Background="Transparent" Foreground="#cbd5e1" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" IsReadOnly="True" BorderThickness="0" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" />
                            </ScrollViewer>
                        </Border>

                        <!-- Progress Bar -->
                        <ProgressBar x:Name="pbProgress" Grid.Row="2" Height="3" Margin="0,6,0,0" Background="#161922" Foreground="#3b82f6" BorderThickness="0" Value="0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>